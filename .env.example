# ============================================================================
# Health-IA — plantilla de variables de entorno
# ============================================================================
# Copia este archivo a `health/healthproject/.env` (el que django-environ lee
# con `environ.Env.read_env()`) y completá los valores.
#
#   cp .env.example health/healthproject/.env
#
# ⚠️  NUNCA commitees el archivo `.env` real. Ya está en .gitignore (`**/.env`).
#     `.env.example` SÍ se commitea — es solo una plantilla con placeholders.
#
# Prioridad de django-environ (mayor gana):
#   1. Variables de entorno del proceso (export / OS env / Docker)
#   2. Valores en health/healthproject/.env
#   3. `default=` en settings.py (para SECRET_KEY YA NO HAY default → si falta, falla)
# ============================================================================

# ----------------------------------------------------------------------------
# Django SECRET_KEY — OBLIGATORIA (la app no arranca sin ella)
# ----------------------------------------------------------------------------
# Genera una real con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ----------------------------------------------------------------------------
# Clave compartida del sistema de llamadas (pulsador/ESP8266 <-> backend)
# ----------------------------------------------------------------------------
# La misma clave, configurada TAMBIÉN en el firmware del pulsador (defines.h).
# Si difieren, el mensaje se RECHAZA (ya no es decorativo). Rota siempre la
# anterior si estuvo en git/firmware.
# Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CALL_SECRET_KEY=

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
DB_NAME=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# DB_PORT=5432

# ----------------------------------------------------------------------------
# Superusuario inicial — SOLO se exige en el primer arranque sobre base limpia.
# Si ya existe un superusuario en la base, el entrypoint NO pide estas vars.
# ----------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com
